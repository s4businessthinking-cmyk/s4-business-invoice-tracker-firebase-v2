rules_version = '2';

// ============================================================
// S4-BUSINESS INVOICE TRACKER — Firestore Security Rules
// ============================================================
// এই rules প্রতিটা দোকানের নিজস্ব Firebase project-এ বসাতে হবে
// (Firebase Console → Firestore Database → Rules ট্যাব → এই পুরো
// কনটেন্ট পেস্ট করে Publish করুন)।
//
// লজিক: app anonymous auth দিয়ে সাইন-ইন করে (কোনো email/password
// দোকান মালিক জানার দরকার নেই), rules শুধু "signed-in" থাকলেই
// read/write অনুমতি দেয়। যেহেতু এই Firebase project শুধু একটা
// দোকানের জন্যই খোলা হয়েছে, ভিতরের ডেটা এমনিতেই isolated।
//
// বাস্তব একসেস-কন্ট্রোল হয় app-এর নিজের password-check screen
// দিয়ে (SHA-256 hash Firestore-এর shop/info ডকুমেন্টে রাখা থাকে)।
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // shop/info ডকুমেন্ট — shop-এর নাম/ঠিকানা/ফোন + password hash
    match /shop/info {
      allow read: if request.auth != null;
      // প্রথমবার তৈরি (setup) অনুমোদিত যদি ডকুমেন্ট আগে না থাকে
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/shop/info);
      // পরে আপডেট (shop info edit) অনুমোদিত, কিন্তু passwordHash
      // ছাড়া বাকি ফিল্ড বদলানো যাবে (app নিজে passwordHash আলাদাভাবে দরকার হলে বদলাবে)
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // invoices কালেকশন — সব invoice রেকর্ড
    match /invoices/{invoiceId} {
      allow read, write: if request.auth != null;
    }

    // activity কালেকশন — staff audit log (append-only from app)
    match /activity/{activityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
