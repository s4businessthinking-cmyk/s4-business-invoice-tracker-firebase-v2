rules_version = '2';

// ============================================================
// S4-BUSINESS INVOICE TRACKER — Firestore Security Rules
// Email/Password auth ONLY (no Google Sign-In, no Anonymous)
// Every account must verify its email before it can act as an
// active member — client (auth.js) enforces this at login time.
// Owner/Staff roles.
// ============================================================
// Firebase Console → Authentication → Sign-in method:
//   ✅ Email/Password ON
//   ❌ Google ON/OFF doesn't matter — app no longer uses it
//   ❌ Anonymous OFF (security)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    function isActiveMember() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(memberPath())
        && get(memberPath()).data.status == 'active';
    }

    function isOwner() {
      return isActiveMember() && get(memberPath()).data.role == 'owner';
    }

    function inviteDoc(id) {
      return get(/databases/$(database)/documents/invites/$(id));
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function inviteEmailOk(data) {
      return data.email is string && data.email.lower() == authEmail();
    }

    match /shop/info {
      // Public read is intentional: login/setup screens may show shop branding
      // (name) before auth. Sensitive ops still require isOwner() for write.
      allow read: if true;
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/shop/info)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == authEmail();
      allow update: if isOwner();
      allow delete: if false;
    }

    match /members/{uid} {
      // Own profile readable while verifying email (before isActiveMember)
      allow read: if isActiveMember() || (isSignedIn() && uid == request.auth.uid);
      allow create: if isSignedIn() && uid == request.auth.uid && (
        (request.resource.data.role == 'owner'
          && request.resource.data.email == authEmail()
          && request.resource.data.status == 'active')
        ||
        (request.resource.data.role == 'staff'
          && request.resource.data.email == authEmail()
          && request.resource.data.status == 'active'
          && request.resource.data.inviteId is string
          && inviteEmailOk(inviteDoc(request.resource.data.inviteId).data)
          && inviteDoc(request.resource.data.inviteId).data.status == 'pending')
      );
      allow update: if isOwner()
        || (uid == request.auth.uid
            && resource.data.role == 'staff'
            && request.resource.data.role == 'staff'
            && request.resource.data.email == resource.data.email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));
      allow delete: if false;
    }

    match /invites/{inviteId} {
      // Pending invites readable before login (staff signup looks up invite first).
      // After login, any signed-in user can read (small shop).
      allow read: if resource.data.status == 'pending' || isSignedIn();
      allow create: if isOwner()
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'staff'
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.email is string;
      allow update: if isOwner()
        || (isSignedIn()
            && inviteEmailOk(resource.data)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && inviteEmailOk(request.resource.data));
      allow delete: if isOwner();
    }

    match /invoices/{invoiceId} {
      allow read, create, update, delete: if isActiveMember();
    }
    match /customers/{id} {
      allow read, create, update, delete: if isActiveMember();
    }
    match /vehicles/{id} {
      allow read, create, update, delete: if isActiveMember();
    }
    match /receipts/{id} {
      allow read, create, update, delete: if isActiveMember();
    }
    match /creditNotes/{id} {
      allow read, create, update, delete: if isActiveMember();
    }
    match /debitNotes/{id} {
      allow read, create, update, delete: if isActiveMember();
    }
    match /cheques/{id} {
      allow read, create, update, delete: if isActiveMember();
    }
    match /discounts/{id} {
      allow read, create, update, delete: if isActiveMember();
    }

    match /activity/{activityId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember();
      allow update, delete: if false;
    }
  }
}
