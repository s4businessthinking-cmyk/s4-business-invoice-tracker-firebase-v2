# Copy to keystore.properties (gitignored) and fill real values before release builds.
# Example:
#   storeFile=../release.keystore
#   storePassword=***
#   keyAlias=s4release
#   keyPassword=***
#
# Generate a keystore once:
#   keytool -genkey -v -keystore release.keystore -alias s4release -keyalg RSA -keysize 2048 -validity 10000

storeFile=../release.keystore
storePassword=CHANGE_ME
keyAlias=s4release
keyPassword=CHANGE_ME
